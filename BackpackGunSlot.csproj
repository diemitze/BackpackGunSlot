<Project Sdk="Microsoft.NET.Sdk">
  <!-- The repo keeps the server mod in server\, which must not be globbed into the plugin. -->
  <ItemGroup>
    <Compile Remove="server\**" />
    <None Remove="server\**" />
  </ItemGroup>

  <Import Project="..\..\ported-4.1\Spt41.Client.props" />

  <PropertyGroup>
    <AssemblyName>BackpackGunSlot</AssemblyName>
    <RootNamespace>BackpackGunSlot</RootNamespace>
    <AssemblyVersion>1.1.3</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\smg.png" LogicalName="BackpackGunSlot.smg.png" />
    <EmbeddedResource Include="assets\shotgun.png" LogicalName="BackpackGunSlot.shotgun.png" />
  </ItemGroup>

</Project>
