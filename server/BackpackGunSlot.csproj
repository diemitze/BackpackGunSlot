<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>BackpackGunSlot</RootNamespace>
    <AssemblyName>BackpackGunSlot</AssemblyName>
    <Version>1.1.3</Version>
    <Authors>20fpsguy</Authors>
    <Nullable>enable</Nullable>
    <!-- Untested mod: deploy to the test install, never the play install. -->
    <DeployDir Condition="'$(DeployDir)' == ''">D:\SPT 4.1 dev</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config\config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)' == 'true' And '$(NoDeploy)' != 'true'">
    <MakeDir Directories="$(DeployDir)\SPT_Runtime\user\mods\BackpackGunSlot\config" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)\SPT_Runtime\user\mods\BackpackGunSlot" />
    <Copy SourceFiles="config\config.json" DestinationFolder="$(DeployDir)\SPT_Runtime\user\mods\BackpackGunSlot\config" SkipUnchangedFiles="true" />
  </Target>

</Project>
